{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-town.invalid/worldgen/validation.schema.json",
  "title": "worldgen.validation/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "world_id", "candidate_sha256", "checker", "evidence"],
  "properties": {
    "schema": {"const": "worldgen.validation/1"},
    "status": {"const": "passed"},
    "world_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
