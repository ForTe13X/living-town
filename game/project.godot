; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="小镇有灵 Living Town"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[threading]

worker_pool/max_threads=8

[editor]

import/use_multiple_threads=false

[autoload]

Art="*res://scripts/Art.gd"
Sim="*res://scripts/Sim.gd"
AIBackend="*res://scripts/AIBackend.gd"
Audio="*res://scripts/Audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

[editor]

movie_writer/mix_rate=44100

[editor_plugins]

enabled=PackedStringArray("res://addons/worldgen/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/town_raw_sources/plugin.cfg")

[godot_mcp_pro]

require_connection_token=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043137, 0.070588, 0.054902, 1)
