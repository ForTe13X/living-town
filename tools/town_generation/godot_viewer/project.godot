; Independent asset consumer. Does not change the playable game.
config_version=5

[application]
config/name="Living Town Territory Inspection"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=30

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800

[threading]
worker_pool/max_threads=6

[editor]
movie_writer/mix_rate=44100

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=2
