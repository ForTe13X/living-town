# LLM model weights — download separately (see docs/03 / docs/11); never commit
game/models/*.gguf
# Godot editor caches
.godot/
game/.godot/
*.tmp
# local scratch
*.log
# NobodyWho GDExtension binaries (~140MB) — install from upstream release (see README setup note)
game/addons/nobodywho/*.dll
game/addons/nobodywho/*.so
game/addons/nobodywho/.gdignore
# Embedded GLB textures are extracted automatically by Godot during import.
game/assets/town3d/living_town_game_*.png

# Android build toolchain + downloads + APK output (see docs/18)
build/

# Godot editor import cache (regenerated on editor open)
*.import
*.uid

# Godot Android gradle build template (editor re-installs via "Install Android Build Template")
game/android/

# Python bytecode caches (tools/*.py 与 bench/bakeoff/*.py 跑一次就会生成)
__pycache__/
*.pyc

# LLM-judge 负载：analysis/phase_d/packet_c30.jsonl 638MB + packet_smoke.jsonl 84MB（2026-07-19 那轮）。
# 只挡这两类大包，【不】挡整个 analysis/ —— analysis/ 在 codex/repository-review-2026-07-12 上是
# 【被跟踪路径】(analysis/repository-review-2026-07-12/、analysis/cross-disciplinary-.../)，
# 整目录 ignore 会在那条分支合回来时静默吞掉 11 份评审文档。
analysis/**/packet_*.jsonl
# Large reproducible town assets are published as checksum-verified release files.
game/assets/town3d/*.glb
art/**/*.zip
art/**/*.glb
art/**/*.blend
art/**/*.blend1
art/**/checkpoints/
art/**/references/
art/living_town/integration/
art/interactive_delivery/*.exe
art/interactive_delivery/*.pck
