{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Editor-only native landcover profile v2",
  "$comment": "Associate this schema externally; do not add a $schema field to runtime data. The writer/native parser additionally enforce distinct GUIDs, distinct source paths, unique LayerInfo packages separate from Map/Material, raw ASCII-no-BOM64KiB/SHA, source bytes and live world identity. Population and final art remain outside native profile-read qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "map_path",
    "landscape_actor_label",
    "landscape_guid",
    "edit_layer_guid",
    "material_path",
    "height",
    "weights",
    "layout",
    "roles",
    "visibility_policy",
    "source_scene",
    "prerequisite_read_receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "LivingTown.NativeLandcoverProfile.v2"
    },
    "mode": {
      "const": "owned_editor_preview_no_runtime_paint"
    },
    "map_path": {
      "$ref": "#/$defs/packagePath"
    },
    "landscape_actor_label": {
      "$ref": "#/$defs/tag"
    },
    "landscape_guid": {
      "$ref": "#/$defs/guid"
    },
    "edit_layer_guid": {
      "$ref": "#/$defs/guid"
    },
    "material_path": {
      "$ref": "#/$defs/objectPath"
    },
    "height": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_relative_path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "project_relative_path": {
          "$ref": "#/$defs/sourcePath"
        },
        "bytes": {
          "const": 510050
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_relative_path",
        "bytes",
        "sha256",
        "encoding",
        "per_vertex_sum"
      ],
      "properties": {
        "project_relative_path": {
          "$ref": "#/$defs/sourcePath"
        },
        "bytes": {
          "const": 1020100
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "encoding": {
          "const": "uint8_interleaved_RGBA_no_header"
        },
        "per_vertex_sum": {
          "const": 255
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "subsection_size_quads",
        "num_subsections",
        "component_count_xy",
        "origin_cm",
        "scale_xyz",
        "row0",
        "rotation_pitch_yaw_roll"
      ],
      "properties": {
        "width": {
          "const": 505
        },
        "height": {
          "const": 505
        },
        "subsection_size_quads": {
          "const": 63
        },
        "num_subsections": {
          "const": 2
        },
        "component_count_xy": {
          "const": [
            4,
            4
          ]
        },
        "origin_cm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100000000,
            "maximum": 100000000
          }
        },
        "scale_xyz": {
          "const": [
            100,
            100,
            25
          ]
        },
        "row0": {
          "const": "minimum_UE_Y"
        },
        "rotation_pitch_yaw_roll": {
          "const": [
            0,
            0,
            0
          ]
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "name",
            "layer_info_path"
          ],
          "properties": {
            "channel": {
              "const": 0
            },
            "name": {
              "const": "Meadow"
            },
            "layer_info_path": {
              "$ref": "#/$defs/objectPath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "name",
            "layer_info_path"
          ],
          "properties": {
            "channel": {
              "const": 1
            },
            "name": {
              "const": "WoodlandLitter"
            },
            "layer_info_path": {
              "$ref": "#/$defs/objectPath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "name",
            "layer_info_path"
          ],
          "properties": {
            "channel": {
              "const": 2
            },
            "name": {
              "const": "SteepRock"
            },
            "layer_info_path": {
              "$ref": "#/$defs/objectPath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "name",
            "layer_info_path"
          ],
          "properties": {
            "channel": {
              "const": 3
            },
            "name": {
              "const": "PondSoil"
            },
            "layer_info_path": {
              "$ref": "#/$defs/objectPath"
            }
          }
        }
      ]
    },
    "visibility_policy": {
      "const": "exact_engine_singleton_zero_unallocated_edit_and_merged"
    },
    "source_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage",
        "manifest_sha256",
        "population_census_sha256"
      ],
      "properties": {
        "lineage": {
          "$ref": "#/$defs/tag"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "population_census_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prerequisite_read_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 7,
      "maxLength": 256,
      "pattern": "^/Game/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*$"
    },
    "objectPath": {
      "type": "string",
      "maxLength": 513,
      "pattern": "^(?=.{7,256}\\.)/Game/(?:[A-Za-z0-9_]+/)*([A-Za-z0-9_]+)\\.\\1$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 9,
      "maxLength": 256,
      "pattern": "^(?!.*\\.\\.)(?!.*//)Content/[A-Za-z0-9_/.]*[A-Za-z0-9_.]$"
    }
  }
}
