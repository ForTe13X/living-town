  "UE_material_adapter": {
    "tangent_space_normal": false,
    "two_Custom_nodes": {
      "MaterialExpressionCustom_0": {
        "code": "// This exact body is placed inside ONE UE MaterialExpressionCustom function.\n// Global evaluator functions belong in IncludeFilePaths, before that function.\nfloat3 Ps = WestWoodUEPositionToSourceMetres(AbsoluteWorldPositionCm, float3(0,0,0));\nfloat3 Ns = WestWoodUENormalToSource(SmoothNormalUE);\nfloat3 Ng = normalize(cross(ddx(Ps), ddy(Ps)));\nNg = dot(Ng,Ns) < 0 ? -Ng : Ng;\nWestWoodSurface surface = CleftFloorEvaluate(\n    Ps, Ns, Ng, MacroBaseColor, MacroRoughness, MacroMetallic,\n    WestWoodUENormalToSource(MacroNormalUE),\n    RegionMask, RegionMaskSampler,\n    LeafColor, LeafColorSampler, LeafNormal, LeafNormalSampler, LeafARM, LeafARMSampler,\n    SoilColor, SoilColorSampler, SoilNormal, SoilNormalSampler, SoilARM, SoilARMSampler,\n    LeafHeight, LeafHeightSampler, SoilHeight, SoilHeightSampler);\nRoughness = surface.Roughness;\nMetallic = surface.Metallic;\nreturn surface.BaseColor;\n",
        "include": [
          "/Project/Private/LTCleftFloor_v002.ush"
        ]
      },
      "MaterialExpressionCustom_1": {
        "code": "// Normal-property function intentionally excludes the macro color/RM graph.\n// Reuse the canonical evaluator; color/RM fields are discarded, never used as normal inputs.\nfloat3 Ps = WestWoodUEPositionToSourceMetres(AbsoluteWorldPositionCm, float3(0,0,0));\nfloat3 Ns = WestWoodUENormalToSource(SmoothNormalUE);\nfloat3 Ng = normalize(cross(ddx(Ps), ddy(Ps)));\nNg = dot(Ng,Ns) < 0 ? -Ng : Ng;\nWestWoodSurface surface = CleftFloorEvaluate(\n    Ps, Ns, Ng, float3(0,0,0), 0.0, 0.0,\n    WestWoodUENormalToSource(MacroNormalUE),\n    RegionMask, RegionMaskSampler,\n    LeafNormal, LeafNormalSampler, LeafNormal, LeafNormalSampler, LeafNormal, LeafNormalSampler,\n    SoilNormal, SoilNormalSampler, SoilNormal, SoilNormalSampler, SoilNormal, SoilNormalSampler,\n    LeafHeight, LeafHeightSampler, SoilHeight, SoilHeightSampler);\nreturn WestWoodSourceNormalToUE(surface.NormalSource);\n",
        "include": [
          "/Project/Private/LTCleftFloor_v002.ush"
        ]
      }
    },
